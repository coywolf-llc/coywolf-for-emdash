---
/**
 * Renders one Content Blocks block (Note, Details, Affiliate disclosure,
 * Quote) when its feature is on; nothing otherwise. The shared CSS goes out
 * once per page, before the first block. Markup comes from
 * contentBlocks/render.ts, which the admin previews use too. Rendered here
 * (not as an HTML block) so <details>, <aside> and <figure> aren't stripped
 * by EmDash's HTML sanitizer.
 */
import { siteFeatureOn } from "../../core/features.js";
import {
	CONTENT_BLOCKS_CSS,
	blockId,
	normalizeDetails,
	normalizeDisclosure,
	normalizeNote,
	normalizeQuote,
	renderDetailsHtml,
	renderDisclosureHtml,
	renderNoteHtml,
	renderQuoteHtml,
} from "../../contentBlocks/render.js";
import { siteDisclosureSettings } from "../../contentBlocks/settings.js";

interface Props {
	kind: "note" | "details" | "disclosure" | "quote";
	node: Record<string, unknown>;
}

const { kind, node } = Astro.props as Props;

// Claim the per-page CSS synchronously, before any await, so the first block
// in document order carries it even when siblings render in parallel.
const locals = (Astro.locals ?? {}) as Record<string, unknown>;
const first = !locals.__cwContentBlocksCss;
locals.__cwContentBlocksCss = true;

let html = "";
if (node && (await siteFeatureOn(`contentBlocks.${kind}`))) {
	if (kind === "note") html = renderNoteHtml(normalizeNote(node), blockId("cw-note", node._key));
	else if (kind === "details") html = renderDetailsHtml(normalizeDetails(node));
	else if (kind === "disclosure") html = renderDisclosureHtml(normalizeDisclosure(node), await siteDisclosureSettings());
	else html = renderQuoteHtml(normalizeQuote(node));
}
if (!html && first) locals.__cwContentBlocksCss = false;
const css = html && first ? CONTENT_BLOCKS_CSS : "";
---

{css && <style is:inline set:html={css} />}
{html && <Fragment set:html={html} />}
