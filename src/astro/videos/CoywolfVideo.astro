---
/**
 * Coywolf Video: a Cloudflare Stream player in a <figure>, sized by the
 * video's aspect ratio (no layout shift), with an optional caption and
 * plays/likes/date row. Schema comes from the page:metadata hook, not from here.
 *
 * Light embed (the default; Videos → Player): the page shows only the poster,
 * sized for the screen, and loads Stream's player (~350 KB of JavaScript) when
 * someone presses play, or for autoplaying videos on the visitor's first
 * interaction once the video is on screen. Without it a video near the top of a page loaded
 * with the page and, on a slow phone connection, became the page's largest
 * paint several seconds late. Without JavaScript the player loads as before.
 *
 * Used for `coywolf-video` Portable Text blocks, and usable directly from a
 * theme: <CoywolfVideo node={{ uid, preset: "gif" }} />. Also accepts the
 * WordPress cloudflare-stream marker attributes (id, host, aspect, name,
 * description, seconds), which default to the GIF preset.
 */
import { getPublicPluginApiRouteHandler } from "emdash/plugin-utils";

import { PLUGIN_ID, siteFeatureOn } from "../../core/features.js";
import {
	type VideoBlock,
	aspectRatio,
	clockDuration,
	isUid,
	normalizeCustomerHost,
	playerConfig,
	playerSrc,
	posterImage,
	posterUrl,
} from "../../videos/lib.js";

interface Props {
	node: VideoBlock;
}

interface EmbedData {
	host: string | null;
	accent: string | null;
	background: string | null;
	lightEmbed?: boolean;
	engagement: boolean;
	video: {
		name: string | null;
		description: string | null;
		duration: number;
		created: string | null;
		width: number;
		height: number;
		posterTime: number | null;
		posterImage: string | null;
	} | null;
	counts: { plays: number; likes: number } | null;
}

const { node } = Astro.props;
const uid = isUid(node?.uid) ? node.uid : isUid(node?.id) ? node.id : null;
const on = await siteFeatureOn("videos");

let data: EmbedData | null = null;
if (on && uid) {
	const handler = getPublicPluginApiRouteHandler(Astro.locals as Parameters<typeof getPublicPluginApiRouteHandler>[0]);
	if (handler) {
		try {
			const res = (await handler(
				PLUGIN_ID,
				"POST",
				"/videos/embed",
				new Request(new URL(`/_emdash/api/plugins/${PLUGIN_ID}/videos/embed`, Astro.url), {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({ uid }),
				}),
			)) as { success?: boolean; data?: EmbedData };
			data = res?.success && res.data ? res.data : null;
		} catch (error) {
			console.warn("coywolf-pack: video embed data failed", error);
		}
	}
}

const host = normalizeCustomerHost(node?.host) ?? data?.host ?? null;
const video = data?.video ?? null;
const cfg = playerConfig(node ?? {});
const str = (v: unknown) => (typeof v === "string" && v.trim() ? v.trim() : undefined);
const num = (v: unknown) => (typeof v === "number" && Number.isFinite(v) && v >= 0 ? v : undefined);
const name = str(node?.title) ?? str(node?.name) ?? video?.name ?? "Video";
const description = str(node?.caption) ?? str(node?.description) ?? video?.description ?? "";
const block = { posterTime: num(node?.posterTime), posterImage: str(node?.posterImage) };
const poster = uid
	? posterUrl(host, uid, block, { posterTime: video?.posterTime ?? (node?.host ? 1 : undefined), posterImage: video?.posterImage ?? undefined }, undefined, Astro.url.origin)
	: undefined;
const playerExtra = { startTime: num(node?.startTime), poster, accent: data?.accent ?? undefined, background: data?.background ?? undefined };
const src = uid ? playerSrc(host, uid, cfg, playerExtra) : "";
// Light embed: the poster now, the player later. Pressing play starts it at once.
const light = Boolean(uid) && data?.lightEmbed !== false;
const playSrc = uid && light && !cfg.autoplay ? playerSrc(host, uid, { ...cfg, autoplay: true }, playerExtra) : src;
const posterImg = uid && light ? posterImage(host, uid, block, { posterTime: video?.posterTime ?? (node?.host ? 1 : undefined), posterImage: video?.posterImage ?? undefined }, Astro.url.origin) : null;
const ratio = aspectRatio(video?.width, video?.height, num(node?.aspect));
const maxWidth = node?.sizeMode === "maxwidth" && num(node?.maxWidth) ? Math.max(100, Math.round(node.maxWidth as number)) : null;
const counts = data?.engagement ? data.counts : null;
const showPlays = cfg.showPlays && counts !== null && !cfg.autoplay;
const showLikes = cfg.showLikes && counts !== null;
const created = cfg.showDate && video?.created ? new Date(video.created) : null;
const dateText = created && !Number.isNaN(created.getTime()) ? new Intl.DateTimeFormat("en-US", { dateStyle: "medium" }).format(created) : null;
const length = clockDuration(video?.duration ?? num(node?.seconds));
const caption = (cfg.showName && name !== "Video") || (cfg.showDescription && description);
const track = data?.engagement && !cfg.autoplay;
const fallbackHref = /^https?:\/\//i.test(str(node?.url) ?? "") ? str(node?.url) : undefined;
const style = [`--cw-video-ratio:${ratio}`, maxWidth ? `max-width:${maxWidth}px` : "", data?.background ? `--cw-video-bg:${data.background}` : ""]
	.filter(Boolean)
	.join(";");
---

{on && uid ? (
	<figure class:list={["cw-video", cfg.gif && "cw-video--gif"]} style={style} data-cw-video={uid} data-cw-track={track ? "" : undefined}>
		{light && posterImg ? (
			<div class="cw-video__frame" data-cw-player={playSrc} data-cw-title={name} data-cw-auto={cfg.autoplay ? "" : undefined}>
				<img class="cw-video__poster" src={posterImg.src} srcset={posterImg.srcset} sizes="(min-width: 50rem) 768px, 100vw" alt="" loading="lazy" decoding="async" />
				{!cfg.autoplay && (
					<button type="button" class="cw-video__play" data-cw-play aria-label={`Play video: ${name}`}>
						<svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" focusable="false"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
					</button>
				)}
				<noscript>
					<iframe src={src} title={name} loading="lazy" allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture;" allowfullscreen></iframe>
				</noscript>
			</div>
		) : (
			<div class="cw-video__frame">
				<iframe
					src={src}
					title={name}
					loading="lazy"
					allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture;"
					allowfullscreen
				></iframe>
			</div>
		)}
		{caption && (
			<figcaption class="cw-video__caption">
				{cfg.showName && <strong class="cw-video__name">{name}</strong>}
				{cfg.showName && cfg.showDescription && description && " — "}
				{cfg.showDescription && description && <span class="cw-video__desc">{description}</span>}
			</figcaption>
		)}
		{(showPlays || showLikes || dateText) && (
			<div class="cw-video__meta">
				{showLikes && (
					<button type="button" class="cw-video__like" data-cw-like={uid} aria-pressed="false">
						<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
							<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.29 1.51 4.04 3 5.5l7 7Z" />
						</svg>
						<span class="cw-video__sr">Like this video</span>
						<span class="cw-video__likes" data-cw-likes>{counts && counts.likes > 0 ? counts.likes.toLocaleString("en-US") : ""}</span>
					</button>
				)}
				{showPlays && (
					<span class="cw-video__plays" data-cw-plays>
						{counts && counts.plays > 0 ? `${counts.plays.toLocaleString("en-US")} ${counts.plays === 1 ? "view" : "views"}` : ""}
					</span>
				)}
				{dateText && <time class="cw-video__date" datetime={video?.created ?? undefined}>{dateText}</time>}
				{length && cfg.showDate && <span class="cw-video__len">{length}</span>}
			</div>
		)}
	</figure>
) : on && fallbackHref ? (
	<p class="cw-video-link"><a href={fallbackHref}>{str(node?.title) ?? "Watch the video"}</a></p>
) : null}

<style>
	.cw-video {
		--cw-video-bg: transparent;
		--cw-video-muted: #57606a;
		--cw-video-accent: #d1242f;
		margin-inline: auto;
		margin-block: 1.5em;
	}
	@media (prefers-color-scheme: dark) {
		.cw-video {
			--cw-video-muted: #9198a1;
			--cw-video-accent: #ff7b72;
		}
	}
	.cw-video__frame {
		position: relative;
		aspect-ratio: var(--cw-video-ratio, 16 / 9);
		background: var(--cw-video-bg);
		border-radius: 0.5rem;
		overflow: hidden;
	}
	/* :global: the light embed creates this iframe in script, so it has no scoped-style attribute. */
	.cw-video__frame :global(iframe) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}
	.cw-video__poster {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.cw-video__play {
		position: absolute;
		inset: 50% auto auto 50%;
		translate: -50% -50%;
		display: grid;
		place-items: center;
		width: 4rem;
		height: 4rem;
		padding: 0;
		padding-left: 0.2rem;
		border: 0;
		border-radius: 50%;
		background: rgb(0 0 0 / 0.65);
		color: #fff;
		cursor: pointer;
		transition: background 0.15s;
	}
	.cw-video__play:hover {
		background: var(--cw-video-accent);
	}
	.cw-video__play:focus-visible {
		outline: 3px solid #fff;
		outline-offset: 2px;
	}
	.cw-video--gif .cw-video__frame {
		border-radius: 0;
	}
	.cw-video__caption {
		margin-top: 0.5em;
		font-size: 0.95em;
	}
	.cw-video__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75em;
		margin-top: 0.5em;
		font-size: 0.875em;
		color: var(--cw-video-muted);
	}
	.cw-video__plays:empty {
		display: none;
	}
	.cw-video__like {
		display: inline-flex;
		align-items: center;
		gap: 0.35em;
		min-height: 2rem;
		padding: 0.25em 0.75em;
		border: 1px solid currentColor;
		border-radius: 999px;
		background: transparent;
		color: inherit;
		font: inherit;
		cursor: pointer;
	}
	/* No likes yet: drop the empty count so the gap doesn't push the heart off center. */
	.cw-video__likes:empty {
		display: none;
	}
	.cw-video__like[aria-pressed="true"] {
		color: var(--cw-video-accent);
	}
	.cw-video__like[aria-pressed="true"] svg {
		fill: currentColor;
	}
	.cw-video__like:focus-visible {
		outline: 2px solid var(--cw-video-accent);
		outline-offset: 2px;
	}
	.cw-video__sr {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
</style>

<script>
	// Light embed (poster first, player on demand), plays (once per session,
	// after 2 seconds of playback) and likes. Stream's player SDK is loaded only
	// to count plays, and only once a player exists.
	const API = "/_emdash/api/plugins/coywolf-pack/videos/";
	const post = (path: string, uid: string) =>
		fetch(API + path, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ uid }) })
			.then((r) => (r.ok ? (r.json() as Promise<{ data?: { plays?: number; likes?: number; liked?: boolean } }>) : null))
			.then((r) => r?.data ?? null)
			.catch(() => null);
	const store = {
		get: (k: string) => { try { return sessionStorage.getItem(k) ?? localStorage.getItem(k); } catch { return null; } },
		session: (k: string) => { try { sessionStorage.setItem(k, "1"); } catch { /* private mode */ } },
		like: (k: string, on: boolean) => { try { on ? localStorage.setItem(k, "1") : localStorage.removeItem(k); } catch { /* private mode */ } },
	};

	type StreamPlayer = { addEventListener(e: string, f: () => void): void; currentTime: number };
	let sdk: Promise<((el: HTMLIFrameElement) => StreamPlayer) | null> | null = null;
	const loadSdk = () =>
		(sdk ??= new Promise((resolve) => {
			const s = document.createElement("script");
			s.src = "https://embed.cloudflarestream.com/embed/sdk.latest.js";
			s.async = true;
			s.onload = () => resolve((window as unknown as { Stream?: (el: HTMLIFrameElement) => StreamPlayer }).Stream ?? null);
			s.onerror = () => resolve(null);
			document.head.appendChild(s);
		}));

	/** Count a play (once per session) after 2 seconds of playback in this figure's player. */
	const track = (fig: HTMLElement, frame: HTMLIFrameElement) => {
		const uid = fig.dataset.cwVideo as string;
		if (!fig.hasAttribute("data-cw-track") || store.get(`cw-video-play-${uid}`)) return;
		void loadSdk().then((Stream) => {
			if (!Stream) return;
			const player = Stream(frame);
			let done = false;
			player.addEventListener("timeupdate", () => {
				if (done || player.currentTime < 2) return;
				done = true;
				store.session(`cw-video-play-${uid}`);
				void post("play", uid).then((r) => {
					const el = fig.querySelector<HTMLElement>("[data-cw-plays]");
					if (el && r && typeof r.plays === "number" && r.plays > 0) el.textContent = `${r.plays.toLocaleString("en-US")} ${r.plays === 1 ? "view" : "views"}`;
				});
			});
		});
	};

	/** Light embed: replace the poster with Stream's player. */
	const load = (frameEl: HTMLElement, focus: boolean) => {
		if (frameEl.querySelector("iframe")) return;
		const frame = document.createElement("iframe");
		frame.src = frameEl.dataset.cwPlayer as string;
		frame.title = frameEl.dataset.cwTitle ?? "Video";
		frame.allow = "accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture;";
		frame.allowFullscreen = true;
		frameEl.querySelector("[data-cw-play]")?.remove();
		frameEl.appendChild(frame);
		// The poster stays underneath until the player has painted, so nothing flashes.
		frame.addEventListener("load", () => frameEl.querySelector(".cw-video__poster")?.remove(), { once: true });
		if (focus) frame.focus();
		const fig = frameEl.closest<HTMLElement>("[data-cw-video]");
		if (fig) track(fig, frame);
	};

	document.querySelectorAll<HTMLElement>("[data-cw-player]").forEach((frameEl) => {
		frameEl.querySelector<HTMLButtonElement>("[data-cw-play]")?.addEventListener("click", () => load(frameEl, true));
	});

	// Autoplaying videos: on the visitor's first interaction (scroll, touch, pointer or
	// key), once the video is (nearly) on screen. Loading on idle instead still ran
	// Stream's player (about 1.5 s of script on a mid-range phone) inside the page's
	// load window, which PageSpeed counts as blocking time.
	const autos = document.querySelectorAll<HTMLElement>("[data-cw-player][data-cw-auto]");
	if (autos.length) {
		let interacted = false;
		const visible = new Set<HTMLElement>();
		const flush = () => {
			if (!interacted) return;
			visible.forEach((el) => load(el, false));
			visible.clear();
		};
		const events = ["scroll", "pointermove", "pointerdown", "touchstart", "keydown", "wheel"] as const;
		const onFirst = () => {
			interacted = true;
			events.forEach((e) => removeEventListener(e, onFirst));
			flush();
		};
		events.forEach((e) => addEventListener(e, onFirst, { passive: true, once: true }));
		if ("IntersectionObserver" in window) {
			const seen = new IntersectionObserver((entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					seen.unobserve(entry.target);
					visible.add(entry.target as HTMLElement);
				}
				flush();
			}, { rootMargin: "200px" });
			autos.forEach((el) => seen.observe(el));
		} else {
			autos.forEach((el) => visible.add(el));
		}
	}

	// Players rendered with the page (light embed off): count plays once they're near the screen.
	const tracked = document.querySelectorAll<HTMLElement>("[data-cw-video][data-cw-track]");
	const io = "IntersectionObserver" in window
		? new IntersectionObserver((entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					io?.unobserve(entry.target);
					const fig = entry.target as HTMLElement;
					const frame = fig.querySelector<HTMLIFrameElement>(".cw-video__frame:not([data-cw-player]) iframe");
					if (frame) track(fig, frame);
				}
			}, { rootMargin: "200px" })
		: null;
	tracked.forEach((fig) => io?.observe(fig));

	document.querySelectorAll<HTMLButtonElement>("[data-cw-like]").forEach((btn) => {
		const uid = btn.dataset.cwLike as string;
		const key = `cw-video-liked-${uid}`;
		if (store.get(key)) btn.setAttribute("aria-pressed", "true");
		let busy = false;
		btn.addEventListener("click", () => {
			if (busy) return;
			busy = true;
			const next = btn.getAttribute("aria-pressed") !== "true";
			btn.setAttribute("aria-pressed", String(next));
			void post("like", uid).then((r) => {
				busy = false;
				if (!r) return;
				btn.setAttribute("aria-pressed", String(Boolean(r.liked)));
				store.like(key, Boolean(r.liked));
				const count = btn.querySelector("[data-cw-likes]");
				if (count && typeof r.likes === "number") count.textContent = r.likes > 0 ? r.likes.toLocaleString("en-US") : "";
			});
		});
	});
</script>
