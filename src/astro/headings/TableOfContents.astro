---
/**
 * The `coywolf-toc` Portable Text block. Lists the headings stamped into the
 * block when the entry was saved (`_headings`), so it always matches the
 * anchors on the page. Collapsing uses <details> (no JS); smooth scrolling is
 * CSS and is skipped for visitors who prefer reduced motion. Markup and CSS
 * come from headings/render.ts, which the admin preview uses too.
 */
import { siteFeatureOn } from "../../core/features.js";
import { type TocDisplay, type TocListStyle, parseLevels, siteHeadingsSettings } from "../../headings/settings.js";
import { TOC_CSS, renderTocHtml, tocTitleTag } from "../../headings/render.js";
import { buildTocTree, countToc, storedHeadings } from "../../headings/toc.js";

const { node } = Astro.props as { node: Record<string, unknown> };

let html = "";
const titleId = `cw-toc-${String(node._key ?? "").replace(/[^A-Za-z0-9_-]/g, "") || "title"}`;

if (await siteFeatureOn("headings.toc")) {
	const defaults = (await siteHeadingsSettings()).toc;
	const levels = parseLevels(node.levels);
	const tree = buildTocTree(storedHeadings(node._headings), levels.length ? levels : defaults.levels);
	if (countToc(tree) >= defaults.minHeadings) {
		const listStyle = ["none", "bulleted", "numbered"].includes(node.listStyle as string) ? (node.listStyle as TocListStyle) : defaults.listStyle;
		const display = ["open", "collapsible", "collapsed"].includes(node.display as string) ? (node.display as TocDisplay) : defaults.display;
		html = renderTocHtml(tree, {
			title: (typeof node.title === "string" && node.title.trim()) || defaults.title,
			showTitle: node.showTitle === "show" ? true : node.showTitle === "hide" ? false : defaults.showTitle,
			titleTag: tocTitleTag(node.titleTag),
			listStyle,
			display,
			smooth: defaults.smoothScroll,
			titleId,
		});
	}
}

// The CSS goes out once per page, before the first table.
const locals = (Astro.locals ?? {}) as Record<string, unknown>;
const css = html && !locals.__cwTocCss ? TOC_CSS : "";
if (css) locals.__cwTocCss = true;
---

{css && <style is:inline set:html={css} />}
{html && <Fragment set:html={html} />}
