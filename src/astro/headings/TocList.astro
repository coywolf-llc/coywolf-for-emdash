---
import type { TocNode } from "../../headings/toc.js";

interface Props {
	nodes: TocNode[];
	ordered: boolean;
	root?: boolean;
}
const { nodes, ordered, root = false } = Astro.props;
const Tag = ordered ? "ol" : "ul";
---

<Tag class={root ? "cw-toc__list" : undefined}>
	{nodes.map((n) => (
		<li>
			<a href={`#${n.id}`}>{n.text}</a>
			{n.children.length > 0 && <Astro.self nodes={n.children} ordered={ordered} />}
		</li>
	))}
</Tag>
