---
/**
 * Accessible breadcrumb trail (WAI-ARIA breadcrumb pattern): <nav
 * aria-label="Breadcrumb"> around an <ol>, links for ancestors, and the
 * current page as plain text with aria-current="page". Separators are CSS, so
 * screen readers skip them.
 *
 * The trail is, in order: `items`, `page.breadcrumbs` (the theme's
 * PublicPageContext), the trail EmDashHead published for this path, or one
 * derived from the URL path. Unset options use the Headings & TOC settings.
 *
 *   import { Breadcrumbs } from "@coywolf/emdash/astro";
 *   <Breadcrumbs page={page} />
 */
import { siteFeatureOn } from "../../core/features.js";
import { type Crumb, capturedPage, cssString, resolveTrail } from "../../headings/breadcrumbs.js";
import { SEPARATORS, type SeparatorPreset, siteHeadingsSettings } from "../../headings/settings.js";

interface Props {
	items?: Crumb[];
	page?: { breadcrumbs?: Crumb[]; pageTitle?: string | null; title?: string | null };
	/** Current page title, when neither `items` nor `page` gives one. */
	title?: string | null;
	/** A preset name (slash, chevron, guillemet, bullet, arrow, gt) or any short string. */
	separator?: string;
	homeLabel?: string;
	showHome?: boolean;
	showCurrent?: boolean;
	class?: string;
	label?: string;
}

const props = Astro.props;
let trail: Crumb[] = [];
let sepClass = "";
let sepStyle: string | undefined;

if (await siteFeatureOn("headings.breadcrumbs")) {
	const settings = (await siteHeadingsSettings()).breadcrumbs;
	const captured = props.items || props.page ? null : capturedPage(Astro.url.pathname);
	trail = resolveTrail({
		path: Astro.url.pathname,
		items: props.items ?? props.page?.breadcrumbs ?? captured?.items,
		title: props.page?.pageTitle ?? props.page?.title ?? props.title ?? captured?.title,
		homeLabel: props.homeLabel?.trim() || settings.homeLabel,
		showHome: props.showHome ?? settings.showHome,
		showCurrent: props.showCurrent ?? settings.showCurrent,
	});
	const separator = props.separator ?? (settings.customSeparator || settings.separator);
	if (separator in SEPARATORS) sepClass = `cw-breadcrumbs--sep-${separator as SeparatorPreset}`;
	else sepStyle = `--cw-bc-sep:${cssString([...separator].slice(0, 8).join(""))}`;
}
const current = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isCurrent = (url: string) => {
	try {
		return (new URL(url, Astro.url).pathname.replace(/\/+$/, "") || "/") === current;
	} catch {
		return false;
	}
};
---

{trail.length > 0 && (
	<nav class={["cw-breadcrumbs", sepClass, props.class].filter(Boolean).join(" ")} style={sepStyle} aria-label={props.label ?? "Breadcrumb"}>
		<ol class="cw-breadcrumbs__list">
			{trail.map((crumb, i) => (
				<li class="cw-breadcrumbs__item">
					{i === trail.length - 1 && isCurrent(crumb.url) ? (
						<span class="cw-breadcrumbs__current" aria-current="page">{crumb.name}</span>
					) : (
						<a href={crumb.url}>{crumb.name}</a>
					)}
				</li>
			))}
		</ol>
	</nav>
)}

<style is:global>
	.cw-breadcrumbs {
		--cw-bc-sep: "/";
		font-size: 0.875em;
		line-height: 1.4;
	}
	.cw-breadcrumbs__list {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.cw-breadcrumbs__item {
		display: inline-flex;
		align-items: center;
	}
	.cw-breadcrumbs__item + .cw-breadcrumbs__item::before {
		content: var(--cw-bc-sep, "/");
		padding: 0 0.5em;
		opacity: 0.6;
	}
	@supports (content: "x" / "") {
		.cw-breadcrumbs__item + .cw-breadcrumbs__item::before {
			content: var(--cw-bc-sep, "/") / "";
		}
	}
	.cw-breadcrumbs__current {
		font-weight: 600;
	}
	.cw-breadcrumbs--sep-slash {
		--cw-bc-sep: "/";
	}
	.cw-breadcrumbs--sep-chevron {
		--cw-bc-sep: "\203A";
	}
	.cw-breadcrumbs--sep-guillemet {
		--cw-bc-sep: "\00BB";
	}
	.cw-breadcrumbs--sep-bullet {
		--cw-bc-sep: "\2022";
	}
	.cw-breadcrumbs--sep-arrow {
		--cw-bc-sep: "\2192";
	}
	.cw-breadcrumbs--sep-gt {
		--cw-bc-sep: ">";
	}
</style>
